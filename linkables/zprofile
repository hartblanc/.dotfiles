# set up environment variables for brew (as advised by the installer script)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# set up environment variables for pyenv (as advised by the installer script)
if whence pyenv >/dev/null; then
    eval "$(pyenv init --path)"
fi

export NERD_FONT="NerdFontMono"

# set default editor to neovim (used for e.g. commit messages)
export EDITOR=nvim

# drop repeated PATH entries, so adding a directory that's already there does nothing
typeset -U path PATH

# user-installed binaries (claude, plz, and pip3 --user and pipx installs)
path=($HOME/.local/bin $path)

# add cargo binaries to the path to access rusty CLIs (rg, fd, fzf etc.)
path+=($HOME/.cargo/bin)
